# Telegram Bot Token (BotFather'dan al)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat ID'leri (virgülle ayır)
TELEGRAM_CHAT_IDS=your_chat_id_1,your_chat_id_2

# Email (opsiyonel yedek bildirim)
EMAIL_TO=ghaksever@gmail.com
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Kontrol aralığı (saniye)
CHECK_INTERVAL=45
